    "MOD": {
        "prefix": "MOD",
        "body": [
            "struct mint {",
            "    long long v;",
            "    mint(long long _v = 0) {",
            "        v = (_v % MOD + MOD) % MOD;",
            "    }",
            "",
            "    mint pow(long long n) const {",
            "        mint res = 1, a = *this;",
            "        while (n > 0) {",
            "            if (n & 1) res *= a;",
            "            a *= a;",
            "            n >>= 1;",
            "        }",
            "        return res;",
            "    }",
            "",
            "    // 乘法逆元（费马小定理）",
            "    mint inv() const {",
            "        return pow(MOD - 2);",
            "    }",
            "",
            "    mint& operator+=(const mint& o) {",
            "        v = (v + o.v) % MOD;",
            "        return *this;",
            "    }",
            "    mint& operator-=(const mint& o) {",
            "        v = (v - o.v + MOD) % MOD;",
            "        return *this;",
            "    }",
            "    mint& operator*=(const mint& o) {",
            "        v = (v * o.v) % MOD;",
            "        return *this;",
            "    }",
            "    mint& operator/=(const mint& o) {",
            "        return *this *= o.inv();",
            "    }",
            "",
            "    friend mint operator+(mint a, const mint& b) {",
            "        return a += b;",
            "    }",
            "    friend mint operator-(mint a, const mint& b) {",
            "        return a -= b;",
            "    }",
            "    friend mint operator*(mint a, const mint& b) {",
            "        return a *= b;",
            "    }",
            "    friend mint operator/(mint a, const mint& b) {",
            "        return a /= b;",
            "    }",
            "};$0"
        ],
        "description": "Modular Arithmetic Template (mint) using Fermat's Little Theorem"
    },
